    },
    {
      "name": "forms",
      "item": [
        {
          "name": "Form-data echo",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Rustman", "type": "text" },
                { "key": "role", "value": "tester", "type": "text" },
                { "key": "debug", "value": "1", "type": "text", "disabled": true }
              ]
            },
            "url": {
              "raw": "https://httpbin.org/post",
              "protocol": "https",
              "host": ["httpbin", "org"],
              "path": ["post"]
            }
          }
        }
      ]
    },
    {
      "name": "graphql",
      "item": [
        {
          "name": "Country by code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Country($code: ID!) {\n  country(code: $code) {\n    name\n    capital\n    currency\n  }\n}",
                "variables": "{\n  \"code\": \"ID\"\n}"
              }
            },
            "url": {
              "raw": "https://countries.trevorblades.com/",
              "protocol": "https",
              "host": ["countries", "trevorblades", "com"],
              "path": [""]
            }
          }
        }
      ]
    },
